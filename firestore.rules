rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMceStudent() {
      return isAuthenticated() && 
             request.auth.token.email.matches('.*@mce\\.edu\\.in');
    }

    function isOwner(data) {
      return isAuthenticated() && data.ownerId == request.auth.uid;
    }

    // Items collection:
    match /items/{itemId} {
      // Anyone can read (browsing is allowed)
      allow read: if true;

      // Only verified @mce.edu.in students can create items
      // They MUST set themselves as the owner
      allow create: if isMceStudent() && 
                      request.resource.data.ownerId == request.auth.uid;

      // Only the owner can update or delete their items
      // They cannot change the ownerId during update
      allow update: if isOwner(resource.data) && 
                      request.resource.data.ownerId == resource.data.ownerId;
                      
      allow delete: if isOwner(resource.data);
    }

    // Profiles collection:
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Requests collection:
    match /requests/{requestId} {
      allow create: if isAuthenticated();
      // Only the requester or the owner of the item can read the request
      allow read: if isAuthenticated() && 
                    (request.auth.uid == resource.data.requesterId || 
                     request.auth.uid == resource.data.ownerId);
      // Only the owner of the item can update the status
      allow update: if isAuthenticated() && 
                      request.auth.uid == resource.data.ownerId &&
                      request.resource.data.requesterId == resource.data.requesterId;
      allow delete: if isAuthenticated() && 
                      request.auth.uid == resource.data.requesterId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
